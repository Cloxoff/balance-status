# ==============================================================================
# FazerCards Price Tracker — Файл конфигурации (.env)
# ==============================================================================

# Токен вашего Telegram-бота (получить у @BotFather в Telegram)
BOT_TOKEN=(bot token)

# Telegram ID получателя уведомлений (можно узнать у бота @userinfobot)
# Если получателей несколько, укажите их через запятую, например: 123456789,987654321
CHAT_ID=(OZ TELEGRAM IDIN)

# API ключ FazerCards (из личного кабинета FazerCards / MCP интеграции)
FAZERCARDS_API_KEY=(FAZER API)

# URL адрес MCP эндпоинта FazerCards
# Формат: https://api.fzr.cards/mcp/ВАШ_MCP_SLUG
FAZERCARDS_API_URL=

# Минимальный порог изменения цены в долларах ($) для отправки уведомления.
# Базовая цена в кэше обновляется ТОЛЬКО при превышении этого порога (по умолчанию 0.05 = 5 центов).
# Незначительные колебания накапливаются, пока сумма изменений не достигнет порога.
MIN_DIFF=0.05

# Интервал автоматической проверки цен в секундах (по умолчанию 60 секунд)
CHECK_INTERVAL=60

# Необязательный фильтр по названиям игр или товаров через запятую.
# Например: PUBG,Mobile Legends
# Если оставить пустым — скрипт будет отслеживать все доступные товары в каталоге.
FILTER_KEYWORDS=PUBG

MAGLUMATLARY () YAYSYZ YAZ